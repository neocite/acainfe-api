NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=acainfe

# Chave para cadastrar empresas (POST /v1/tenants com header x-admin-key). Mínimo 24 caracteres.
ADMIN_API_KEY=troque-por-um-segredo-longo-e-aleatorio

# Chave do BACKEND do app de onboarding (Replit) para as rotas /v1/app. Mínimo 32 caracteres.
APP_API_KEY=

# Master keys (KEK) que cifram os certificados A1. Gere com: openssl rand -base64 32
# Formato id:base64[,id:base64] — para rotacionar, adicione uma nova e mude MASTER_KEY_ID.
MASTER_KEYS=k1:COLE_AQUI_32_BYTES_EM_BASE64
MASTER_KEY_ID=k1

# URL pública da API (links assinados do PDF, webhook AbacatePay, comando do MCP). Domínio em punycode.
PUBLIC_BASE_URL=https://api.xn--aanfe-yra7b.com
LINK_SIGNING_SECRET=troque-por-outro-segredo-longo

# E-mail (Resend). Sem chave, os e-mails ficam só em memória (dev).
RESEND_API_KEY=
EMAIL_FROM=açaínfe <notas@xn--aanfe-yra7b.com>

# WhatsApp (uazapi). Servidor e token da instância.
UAZAPI_BASE_URL=
UAZAPI_TOKEN=

# Fila (Agenda sobre MongoDB)
# CNPJs de teste (vírgula): onboarding sem consultar a Receita (empresa fictícia do Simples em SBC).
# Use com certificado autoassinado e apague a empresa no banco depois. Vazio = desligado.
TEST_COMPANY_CNPJS=
JOBS_ENABLED=true
JOBS_PROCESS_EVERY=5 seconds

# Integrações de onboarding
BRASILAPI_URL=https://brasilapi.com.br/api/cnpj/v1
ABACATEPAY_API_URL=https://api.abacatepay.com/v2

# Cobrança interna (preço por NFS-e emitida, em centavos — oferta de lançamento R$ 0,80)
BILLING_PRICE_PER_INVOICE_CENTS=80
# Dias com saldo em aberto antes de pausar a emissão
BILLING_GRACE_DAYS=7
BILLING_PIX_EXPIRES_IN_SECONDS=259200
# Conta AbacatePay DO AÇAÍNFE (recebe os Pix dos clientes). Key com TRANSPARENT:CREATE.
BILLING_ABACATEPAY_API_KEY=
# Webhook da conta do açaínfe: https://<api>/v1/webhooks/billing/abacatepay (evento transparent.completed)
BILLING_ABACATEPAY_WEBHOOK_SECRET=
# Nota mensal do uso (uma por cliente e mês, emitida pela operadora). Vazio = desligado.
# CNPJ da operadora (ex.: EXTRACTIFY) e externalId do produto "prestação de serviço açaí nfe" nela.
BILLING_INVOICE_ISSUER_CNPJ=
BILLING_INVOICE_PRODUCT_EXTERNAL_ID=

# Ginfes (sistema da prefeitura): ME/EPP destes municípios emitem por ele até a prefeitura liberar o
# Emissor Nacional. "none" = todos pelo nacional. Cada empresa pode forçar com fiscalProvider.
GINFES_CITIES=3548708
GINFES_PRODUCTION_URL=https://producao.ginfes.com.br/ServiceGinfesImpl
GINFES_HOMOLOGATION_URL=https://homologacao.ginfes.com.br/ServiceGinfesImpl
# Modo piloto: cada nota do Ginfes espera aprovação (preview_invoice → approve_invoice)
GINFES_PILOT=true
GINFES_POLL_DELAYS_MS=3000,5000,8000,12000
# Grupos da reforma no lote do Ginfes (nbs,trib,ibscbs), no formato de uma NFS-e autorizada em SBC.
# "none" = sem os campos da reforma.
GINFES_RTC_GROUPS=nbs,trib,ibscbs
